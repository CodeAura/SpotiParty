<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The page the host's phone opens to set the Jam link, served on the home network only while SpotiParty is open. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The TV's address, for that page's QR code. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- SpotiParty Hub (Pro): the TV finds the hub with a UDP broadcast and asks it over plain http on the home
         network (hence usesCleartextTraffic below; Spotify and lrclib stay on https). -->
    <!-- Reads the Lyrics add-on (signature permission, granted when both are signed with the same key). -->
    <uses-permission android:name="io.github.cleanyourtv.permission.HOME_WIDGETS" />
    <!-- Opening itself when Spotify starts: Android only lets a background app start a screen with this
         ("Display over other apps"). SpotiParty draws nothing over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <provider android:authorities="io.github.cleanyourtv.lyrics.widget" />
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Only so Android lets SpotiParty see the song playing (needs notification access). Reads no notification. -->
        <service
            android:name=".PartyListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
